# Gmail push sync + triage (`gmail-assist serve`). Reads .env from the repo.
#
# Wants= rather than Requires=: if llama-server stops, sync keeps running and
# triage failures are requeued on serve's 30-minute backstop.
[Unit]
Description=gmail-assist: Gmail push sync and triage
Wants=llama-server.service
After=llama-server.service

[Service]
WorkingDirectory=/ssd/repos/gmail_assist
ExecStart=/home/hobbes/.local/bin/uv run --frozen gmail-assist -v serve
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
# Python exits 143 on systemd's SIGTERM; that's a clean stop, not a failure.
SuccessExitStatus=143
# 78 = Gmail sign-in needed and no way to do it here: the dashboard is off,
# or this store was never signed in. Restarting can't fix that, so stop and
# show the unit as failed; the journal says what to run. (With the dashboard
# on, serve stays up with sync paused and you sign in there.)
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
